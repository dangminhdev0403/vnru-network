generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/directory"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model Organization {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  country            String
  visibility         Visibility          @default(PUBLIC)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  researcherProfiles ResearcherProfile[]

  @@index([visibility, createdAt, id])
}

model ResearcherProfile {
  id             String                @id @default(uuid()) @db.Uuid
  userRef        String?
  displayName    String
  bio            String?
  country        String
  organizationId String                @db.Uuid
  language       String?
  visibility     Visibility            @default(PUBLIC)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expertises     ResearcherExpertise[]

  @@index([visibility, createdAt, id])
  @@index([organizationId])
}

model ExpertiseArea {
  id          String                @id @default(uuid()) @db.Uuid
  slug        String                @unique
  labels      Json
  researchers ResearcherExpertise[]
}

model ResearcherExpertise {
  profileId   String            @db.Uuid
  expertiseId String            @db.Uuid
  profile     ResearcherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expertise   ExpertiseArea     @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@id([profileId, expertiseId])
}
