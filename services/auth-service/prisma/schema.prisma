generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum AuthenticationLevel {
  PASSWORD
  MFA
}

enum MembershipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  email              String?
  firstName          String?
  lastName           String?
  status             UserStatus         @default(ACTIVE)
  externalIdentities ExternalIdentity[]
  sessions           Session[]
  roleAssignments    RoleAssignment[]
  credential         LocalCredential?

  @@unique([email])
}

model LocalCredential {
  userId       String @id
  passwordHash String
  salt         String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalIdentity {
  id      String @id @default(uuid())
  issuer  String
  subject String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
}

model Session {
  id                  String              @id @default(uuid())
  tokenDigest         String              @unique
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime            @default(now())
  activeContextType   String?
  activeContextId     String?
  authenticationLevel AuthenticationLevel @default(PASSWORD)

  @@index([userId, revokedAt])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  permissions     RolePermission[]
  roleAssignments RoleAssignment[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RoleAssignment {
  id          String               @id @default(uuid())
  userId      String
  roleId      String
  contextType String
  contextId   String
  status      RoleAssignmentStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, contextType, contextId])
  @@index([userId, contextType, contextId, status])
}

model SecurityAuditEvent {
  id        String   @id @default(uuid())
  event     String
  actorId   String
  targetId  String
  context   Json
  createdAt DateTime @default(now())
}

model MembershipApplication {
  id               String                      @id @default(uuid())
  fullName         String
  email            String
  organization     String
  professionalRole String
  interest         String
  status           MembershipApplicationStatus @default(PENDING)
  submittedAt      DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([email, status])
}
