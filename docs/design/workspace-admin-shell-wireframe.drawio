  <diagram id="routes" name="03 - Page Distribution">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="Content distribution · Module 01 + Module 02 + Governance" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#071831;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="900" height="40" as="geometry"/></mxCell>
      <mxCell id="h1" value="Overview /workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071831;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="350" height="60" as="geometry"/></mxCell>
      <mxCell id="b1" value="1. Welcome + active context&#xa;2. Continue task shortcuts&#xa;3. Real publication/expert samples&#xa;4. Governance shortcuts only for capable users&#xa;&#xa;REMOVE: four unsupported Pending KPI cards&#xa;REMOVE: marketing-size hero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="350" height="270" as="geometry"/></mxCell>
      <mxCell id="h2" value="Module 01 /workspace/iam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123A78;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="105" width="350" height="60" as="geometry"/></mxCell>
      <mxCell id="b2" value="1. Identity + active context summary&#xa;2. Capability/resource-scope explanation&#xa;3. Security status shortcut&#xa;4. Admin shortcut if authorized&#xa;&#xa;KEEP: read-oriented workspace&#xa;MOVE: implementation/contract prose to help rail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="180" width="350" height="270" as="geometry"/></mxCell>
      <mxCell id="h3" value="Module 02 /workspace/knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123A78;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="105" width="350" height="60" as="geometry"/></mxCell>
      <mxCell id="b3" value="1. Compact unified search/filter bar&#xa;2. Publications results&#xa;3. Experts results&#xa;4. Matching entry through expert cards&#xa;5. Knowledge Graph pending note only&#xa;&#xa;KEEP: independent error/pagination states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="180" width="350" height="270" as="geometry"/></mxCell>
      <mxCell id="h4" value="Access Admin /admin/iam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#F59E0B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="105" width="350" height="60" as="geometry"/></mxCell>
      <mxCell id="b4" value="1. Page header + sync secondary action&#xa;2. Tabs: Users / Roles / Assignments&#xa;3. Users table: main work area&#xa;4. Role master-detail&#xa;5. Assignment form&#xa;&#xa;ADD SHELL; REMOVE standalone admin header&#xa;Preserve backend-authoritative behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="350" height="270" as="geometry"/></mxCell>
      <mxCell id="h5" value="Security /security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#F59E0B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="520" width="730" height="60" as="geometry"/></mxCell>
      <mxCell id="b5" value="Page header + refresh · MFA status · Active sessions · destructive revoke actions&#xa;&#xa;ADD SHELL; REMOVE duplicate standalone brand/header. Keep security content and dialogs. Sign-out lives in account menu; revoke-current remains contextual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=middle;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="595" width="730" height="150" as="geometry"/></mxCell>
      <mxCell id="rule" value="Single implementation seam after approval: expand shared shell ownership to authenticated route group/layout; pages become content-only. Do not clone shell markup into Admin or Security." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#EAB308;fontColor=#713F12;fontStyle=1;fontSize=14;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="785" width="730" height="70" as="geometry"/></mxCell>
