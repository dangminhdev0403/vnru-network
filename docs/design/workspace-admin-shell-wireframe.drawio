        <mxCell id="r-title" value="Phân bố nội dung theo route — shell thống nhất, page content chuyên biệt" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#071831;align=left;" vertex="1" parent="1"><mxGeometry x="54" y="60" width="1020" height="44" as="geometry"/></mxCell>
        <mxCell id="r-h1" value="Overview&#xa;/workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071831;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="145" width="284" height="66" as="geometry"/></mxCell>
        <mxCell id="r-b1" value="• Welcome + active context&#xa;• Continue-task shortcuts&#xa;• Real publication/expert samples&#xa;• Governance shortcuts when allowed&#xa;&#xa;Remove: pending KPI grid&#xa;Remove: marketing-sized hero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8E1EC;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="220" width="284" height="260" as="geometry"/></mxCell>
        <mxCell id="r-h2" value="Module 01 · IAM&#xa;/workspace/iam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123A78;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="145" width="284" height="66" as="geometry"/></mxCell>
        <mxCell id="r-b2" value="• Identity summary&#xa;• Active context&#xa;• Capabilities &amp; resource scope&#xa;• Security shortcut&#xa;• Admin shortcut when authorized&#xa;&#xa;Keep: read-oriented workspace&#xa;Move implementation prose to help" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBD3FF;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="284" height="260" as="geometry"/></mxCell>
        <mxCell id="r-h3" value="Module 02 · Knowledge&#xa;/workspace/knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123A78;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="666" y="145" width="284" height="66" as="geometry"/></mxCell>
        <mxCell id="r-b3" value="• Compact search &amp; filters&#xa;• Publications results&#xa;• Experts results&#xa;• Matching entry from expert cards&#xa;• Pending note only for graph&#xa;&#xa;Keep independent loading/error/pagination states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBD3FF;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="666" y="220" width="284" height="260" as="geometry"/></mxCell>
        <mxCell id="r-h4" value="Access Administration&#xa;/admin/iam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#F59E0B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="972" y="145" width="284" height="66" as="geometry"/></mxCell>
        <mxCell id="r-b4" value="• Header + secondary refresh/sync&#xa;• Users / Roles / Assignments tabs&#xa;• Users table as main work area&#xa;• Role master-detail&#xa;• Assignment form&#xa;&#xa;Add shared shell&#xa;Preserve backend authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6C97F;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="972" y="220" width="284" height="260" as="geometry"/></mxCell>
        <mxCell id="r-h5" value="Security &amp; Sessions&#xa;/security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#F59E0B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1278" y="145" width="268" height="66" as="geometry"/></mxCell>
        <mxCell id="r-b5" value="• MFA/auth level status&#xa;• Active sessions&#xa;• Refresh&#xa;• Revoke actions&#xa;• Security dialogs&#xa;&#xa;Add shared shell&#xa;Remove duplicate brand/header&#xa;Keep destructive actions contextual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F6C97F;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1278" y="220" width="268" height="260" as="geometry"/></mxCell>
        <mxCell id="r-seam" value="IMPLEMENTATION SEAM AFTER DESIGN APPROVAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071831;strokeColor=#2370FF;fontColor=#FFFFFF;fontStyle=1;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="890" height="44" as="geometry"/></mxCell>
        <mxCell id="r-rule" value="Expand shared shell ownership to the authenticated route group/layout. Route pages become content-only. Do not clone sidebar/topbar markup into Admin or Security. Backend authorization remains authoritative." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8E1EC;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="626" width="890" height="94" as="geometry"/></mxCell>
        <mxCell id="r-note" value="Visual intent: operational, calm, premium institutional tech — shared shell coherence without turning every page into a marketing surface." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#BBD3FF;fontColor=#123A78;fontSize=13;fontStyle=1;align=left;spacing=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="752" width="890" height="62" as="geometry"/></mxCell>
