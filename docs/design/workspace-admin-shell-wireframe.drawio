      <mxCell id="rules" value="Responsive rules&#xa;&#xa;• 44px minimum targets&#xa;• Drawer closes on navigation/Escape&#xa;• Active route visible&#xa;• One primary CTA per page&#xa;• Tables become cards or scoped horizontal regions&#xa;• VI/RU/EN labels stress-tested&#xa;• Dialogs fit 320px viewport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="420" height="360" as="geometry"/></mxCell>
