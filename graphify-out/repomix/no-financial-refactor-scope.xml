<file path="services/project-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum ResourceRole {
  LEAD
  MEMBER
}

enum MilestoneStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

model Project {
  id                String              @id @default(uuid()) @db.Uuid
  proposalRef       String              @unique
  decisionRef       String              @unique
  fundingProgramId  String              @db.Uuid
  title             String
  description       String?
  status            ProjectStatus       @default(ACTIVE)
  terminationReason String?
  expectedVersion   Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  members           ProjectMember[]
  milestones        ProjectMilestone[]
  reports           ProgressReport[]
  outcomes          ProjectOutcomeRef[]

  @@index([status])
}

model ProjectMember {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  userId    String       @db.Uuid
  role      ResourceRole
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectMilestone {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @db.Uuid
  title           String
  description     String?
  dueDate         DateTime
  status          MilestoneStatus    @default(DRAFT)
  expectedVersion Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables    ProjectDeliverable[]
  decisions       MilestoneDecision[]
  reports         ProgressReport[]

  @@index([projectId, status])
}

model ProjectDeliverable {
  id          String           @id @default(uuid()) @db.Uuid
  milestoneId String           @db.Uuid
  title       String
  description String?
  url         String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model ProgressReport {
  id              String            @id @default(uuid()) @db.Uuid
  projectId       String            @db.Uuid
  milestoneId     String?           @db.Uuid
  title           String
  content         String
  status          ReportStatus      @default(DRAFT)
  expectedVersion Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model MilestoneDecision {
  id          String           @id @default(uuid()) @db.Uuid
  milestoneId String           @db.Uuid
  reviewerId  String           @db.Uuid
  status      MilestoneStatus
  feedback    String?
  createdAt   DateTime         @default(now())
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model ProjectOutcomeRef {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  outcomeType String
  outcomeRef  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, outcomeType, outcomeRef])
}

model OutboxEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String
  payload   Json
  processed Boolean  @default(false)
