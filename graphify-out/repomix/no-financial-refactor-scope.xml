<file path="services/grant-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OpportunityState {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ProposalState {
  DRAFT
  PAIRED_CONFIRMED
  SUBMITTED
  ELIGIBLE
  INELIGIBLE
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum Country {
  VN
  RU
}

model FundingOpportunity {
  id                 String          @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  fundingProgramRef  String
  state              OpportunityState
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  proposals          JointProposal[]
}

model JointProposal {
  id             String                      @id @default(uuid()) @db.Uuid
  opportunityId  String                      @db.Uuid
  opportunity    FundingOpportunity          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  state          ProposalState
  content        String
  revision       Int                         @default(1)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  participants   ProposalParticipant[]
  confirmations  CollaborationConfirmation[]
  endorsements   OrganizationEndorsement[]
  screenings     EligibilityScreening[]
  decisions      FundingDecision[]
}

model ProposalParticipant {
  id              String        @id @default(uuid()) @db.Uuid
  proposalId      String        @db.Uuid
  proposal        JointProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId          String
  organizationRef String
  country         Country
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([proposalId, country])
  @@unique([proposalId, userId])
}

model CollaborationConfirmation {
  id            String        @id @default(uuid()) @db.Uuid
  proposalId    String        @db.Uuid
  proposal      JointProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  participantId String
  confirmed     Boolean       @default(false)
  confirmedAt   DateTime?

  @@unique([proposalId, participantId])
}

model OrganizationEndorsement {
  id              String        @id @default(uuid()) @db.Uuid
  proposalId      String        @db.Uuid
  proposal        JointProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  organizationRef String
  country         Country
  endorsed        Boolean       @default(false)
  endorsedAt      DateTime?

  @@unique([proposalId, country])
}

model EligibilityScreening {
  id         String        @id @default(uuid()) @db.Uuid
  proposalId String        @db.Uuid
  proposal   JointProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  eligible   Boolean
  reason     String
  screenedBy String
  createdAt  DateTime      @default(now())
}

model FundingDecision {
  id         String        @id @default(uuid()) @db.Uuid
  proposalId String        @db.Uuid
  proposal   JointProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approved   Boolean
  reason     String
  decidedBy  String
  createdAt  DateTime      @default(now())
}

model OutboxEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String
  payload   String   @db.Text
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}
</file>

