# ==========================================
# VN-RU Science-Technology Intelligence Network
# Docker Environment Configuration Template
# ==========================================

# Global Environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_PORT=5432

# Auth Service
AUTH_SERVICE_PORT=3001

# Frontend Portal
FRONTEND_PORT=3000
FRONTEND_URL=http://<vps_ip_or_domain>:8082
NEXTAUTH_URL=http://<vps_ip_or_domain>:8082
NEXTAUTH_SECRET=generate_strong_random_secret_for_production
AUTH_SECRET=generate_strong_random_secret_for_production
AUTH_BRIDGE_SECRET=generate_an_independent_32_character_minimum_secret

# Nginx Gateway Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
