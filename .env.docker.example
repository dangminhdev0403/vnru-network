# ==========================================
# VN-RU Science-Technology Intelligence Network
# Docker Environment Configuration Template
# ==========================================

# Global Environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_PORT=5432

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password_replace_in_prod
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://<vps_ip_or_domain>:8180
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/vnru
KEYCLOAK_CLIENT_ID=vnru-auth
KEYCLOAK_CLIENT_SECRET=replace_with_keycloak_client_secret
KEYCLOAK_PROFILE_CLIENT_ID=vnru-profile-service
KEYCLOAK_PROFILE_CLIENT_SECRET=replace_with_profile_client_secret

# Auth Service
AUTH_SERVICE_PORT=3001

# Frontend Portal
FRONTEND_PORT=3000
FRONTEND_URL=http://<vps_ip_or_domain>:8082
NEXTAUTH_URL=http://<vps_ip_or_domain>:8082
NEXTAUTH_SECRET=generate_strong_random_secret_for_production
AUTH_SECRET=generate_strong_random_secret_for_production

# Nginx Gateway Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
